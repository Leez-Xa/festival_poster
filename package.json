{
  "name": "festival-poster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "start.bat",
    "start:demo": "start_demo.bat",
    "vercel:version": "vercel --version",
    "vercel:login": "vercel --global-config storage/vercel-config login",
    "vercel:whoami": "vercel --global-config storage/vercel-config whoami",
    "vercel:pull": "vercel --global-config storage/vercel-config pull --yes --environment preview",
    "deploy:preview": "vercel --global-config storage/vercel-config",
    "deploy:prod": "vercel --global-config storage/vercel-config --prod"
  },
  "devDependencies": {
    "vercel": "^54.9.1"
  }
}
